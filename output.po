#: games/first_2d/first_2d_09.ja.md
msgid ""
"**インスペクター**の**テーマオーバーライド/定数**セクションで、4つの**マージ"
"ン**値をすべて `10` に設定します。その後、ビューポート上部のメニューバーで、"
"アンカーを**トップワイド**プリセットに設定してください。"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"申し訳ありませんが、進捗バーとして使用できる適切な画像がアートパックにありま"
"せん（1つ存在はしますが、使い勝手の良いフォーマットではありません）。代わりに"
"以下の2つの画像を使用します。1つは緑色のプログレスバー、もう1つは白い枠線で"
"す。これらをプロジェクトフォルダに保存してください。"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"func display_digits(n):\n"
"    var s = \"%08d\" % n\n"
"    for i in 8:\n"
"        get_child(i).texture.region = Rect2(digit_coords[int(s[i])],\n"
"                Vector2(8, 8))\n"
"gdscript\n"
"extends MarginContainer"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"gdscript\n"
"extends HBoxContainer"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"@export var max_shield = 10\n"
"var shield = max_shield:\n"
"    set = set_shield\n"
"gdscript\n"
"func set_shield(value):\n"
"    shield = min(max_shield, value)\n"
"    shield_changed.emit(max_shield, shield)\n"
"    if shield <= 0:\n"
"        hide()\n"
"        died.emit()\n"
"gdscript\n"
"func _on_area_entered(area):\n"
"    if area.is_in_group(\"enemies\"):\n"
"        area.explode()\n"
"        shield -= max_shield / 2\n"
"gdscript\n"
"func _on_area_entered(area):\n"
"    if area.name == \"Player\":\n"
"        queue_free()\n"
"        area.shield -= 1\n"
"```"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"func update_shield(max_value, value):\n"
"    shield_bar.max_value = max_value\n"
"    shield_bar.value = value\n"
"gdscript\n"
"func _on_enemy_died(value):\n"
"    score += value\n"
"    $CanvasLayer/UI.update_score(score)\n"
"gdscript\n"
"signal died\n"
"signal shield_changed"
msgstr ""

#: games/first_2d/first_2d_09.ja.md
msgid ""
"@onready var shield_bar = $HBoxContainer/ShieldBar\n"
"@onready var score_counter = $HBoxContainer/ScoreCounter"
msgstr ""

