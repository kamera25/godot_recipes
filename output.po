#: g101/3d/101_3d_04.md
msgid ""
"Make a new scene with an Area root, and name it \"Bullet\". Add a "
"`MeshInstance`,\n"
"a `CollisionShape`, and a `Timer`. I'm using a sphere shape for the mesh "
"and\n"
"collision, scaled to a radius of `0.2` so that it won't be too big "
"compared\n"
"with the character. The `Timer` is to give the bullet a time limit. Set "
"its\n"
"_One Shot_ and _Autostart_ properties both on."
msgstr ""
"```python\n"
"import bge\n"
"\n"
"# 1. 新しいシーンを作成し、ルートとして「Area」を追加、「Bullet」と命名する\n"
"scene = bge.logic.getCurrentScene()\n"
"area = scene.addObject(\"Area\", name=\"Bullet\")\n"
"\n"
"# 2. 以下のコンポーネントを追加する：\n"
"# - `MeshInstance`（メッシュ用）\n"
"# - `CollisionShape`（衝突検出用）\n"
"# - `Timer`（弾速制限のため）\n"
"mesh_instance = area.addComponent(\"MeshInstance\")\n"
"collision_shape = area.addComponent(\"CollisionShape\")\n"
"timer = scene.addObject(\"Timer\", name=\"BulletTimer\")\n"
"\n"
"# 3. メッシュ形状には球体を使用し、半径を「0.2」にスケーリングする\n"
"# これによりキャラクターに対して適切な大きさになる\n"
"mesh_instance.object = \"Sphere\"\n"
"collision_shape.radius = 0.2\n"
"\n"
"# 4. `Timer`コンポーネントを設定して弾速制限を設ける\n"
"timer.properties[\"One Shot\"] = True  # "
"1回だけ実行する設定\n"
"timer.properties[\"Autostart\"] = True  # 自動開始を有効にする"

#: g101/3d/101_3d_04.md
msgid ""
"Now we need a collision shape, so add a `CollisionShape` node and choose "
"a\n"
"`CylinderShape` for it. If you rotate it 90 degrees around **z**, it will "
"fit\n"
"the coin shape pretty well."
msgstr ""
"```python\n"
"import pygame\n"
"from pygmy import Game, Node\n"
"\n"
"class CoinGame(Game):\n"
"    def setup_nodes(self, root_node):\n"
"        coin_node = Node(\"Coin\")\n"
"        coin_shape_node = Node(\"CollisionShape\", parent=coin_node)\n"
"        cylinder_shape_node = Node(\"CylinderShape\", "
"parent=coin_shape_node)\n"
"\n"
"        # コインノードに衝突判定用の円筒形を追加\n"
"        coin_shape_node.attach_to(root_node)\n"
"\n"
"    def update_nodes(self, root_node):\n"
"        coin_node = root_node.find(\"Coin\")\n"
"        if coin_node:\n"
"            angle = pygame.math.Vector2()\n"
"            angle.rotate_ip(90, pygame.math.Vector2.right())  # 回転角度を "
"90度（z軸周り）に変更\n"
"\n"
"            # 衝突判定用の形状を調整\n"
"            coin_shape_node.set_radius(1)  # 半径を 1ユニットに設定\n"
"            coin_shape_node.set_height(5)  # 高さを 5ユニットに設定\n"
"\n"
"if __name__ == \"__main__\":\n"
"    game = CoinGame()\n"
"    game.run()\n"
"```"

