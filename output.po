#, fuzzy
msgid ""
"func take_damage():\n"
"    velocity *= -1\n"
"    velocity.y = jump_speed\n"
"    can_move = false\n"
"    yield(get_tree().create_timer(1), \"timeout\")\n"
"    can_move = true\n"
"{{< /highlight >}}"
msgstr ""
"func take_damage():\n"
"    velocity *= -1\n"
"    velocity.y = jump_speed\n"
"    can_move = false\n"
"    yield(get_tree().create_timer(1), \"timeout\")\n"
"    can_move = true{{< /highlight >}}"

#: g101/3d/101_3d_04.md
msgid "In the next part: a collection of small improvements."
msgstr "次のパートでは：小さな改良点をまとめた内容をお届けします。"

#: g101/3d/101_3d_04.md
msgid "Add a few coins to your scene and see if you can pick them up:"
msgstr "シーンにコインを数個追加して、拾えるかどうか試してみてください。"

#: g101/3d/101_3d_04.md
msgid ""
"func _on_Spikes_body_entered(body):\n"
"    if body.has_method(\"take_damage\"):\n"
