#: games/first_2d/_index.md games/first_2d/first_2d_end.md
msgid ""
"## <i class=\"fas fa-code-branch\"></i> Download This Project on <i "
"class='fab fa-github'></i> GitHub"
msgstr ""
"## <i class=\"fas fa-code-branch\"></i> このプロジェクトを<i class='fab fa-"
