msgstr ""

#: physics/Godot3_KYN_rigidbody1.md
msgid ""
"> **Note:** In Godot 3.0, `0` degrees points to the right (along the **x** "
"axis).\n"
"> This means you need to add a `Rotation` of `90` to the `Sprite` so it "
"will\n"
"> match the body's direction."
msgstr ""

#: physics/Godot3_KYN_rigidbody1.md
msgid ""
"You can modify a RigidBody2D's behavior via properties such as \"Mass\", "
"\"Friction\",\n"
"or \"Bounce\", which can be set in the Inspector:"
msgstr ""

#: physics/Godot3_KYN_rigidbody1.md
msgid ""
"var thrust = Vector2()\n"
"var rotation_dir = 0\n"
"var screensize"
msgstr ""

#: physics/Godot3_KYN_rigidbody1.md
msgid ""
"{{< highlight swift >}}\n"
"func _physics_process(delta):\n"
"    if position.x > screensize.x:\n"
"        position.x = 0\n"
"    if position.x < 0:\n"
"        position.x = screensize.x\n"
"    if position.y > screensize.y:\n"
"        position.y = 0\n"
"    if position.y < 0:\n"
"        position.y = screensize.y\n"
"    set_applied_force(thrust.rotated(rotation))\n"
"    set_applied_torque(rotation_dir * spin_thrust)\n"
"{{< /highlight >}}"
msgstr ""

