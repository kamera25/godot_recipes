msgstr ""

#: 3D/simple_airplane.ja.md
msgid ""
"func _physics_process(delta):\n"
"    get_input(delta)\n"
"    transform.basis = transform.basis.rotated(transform.basis.x, pitch_input "
"* pitch_speed * delta)\n"
"    transform.basis = transform.basis.rotated(Vector3.UP, turn_input * "
"turn_speed * delta)"
msgstr ""

#: 3D/simple_airplane.ja.md
msgid ""
"# Pitch (climb/dive) input\n"
"    pitch_input = 0\n"
"    if not grounded:\n"
"        pitch_input -= Input.get_action_strength(\"pitch_down\")\n"
"    if forward_speed >= min_flight_speed:\n"
"        pitch_input += Input.get_action_strength(\"pitch_up\")\n"
"gdscript\n"
"extends CharacterBody3D"
msgstr ""

#: 3D/simple_airplane.ja.md
msgid ""
"# Accelerate/decelerate\n"
"    forward_speed = lerpf(forward_speed, target_speed, acceleration * delta)"
msgstr ""

