"　・ `mode` - 表示方法を指定するオプション設定です（詳細は後述）。"
msgstr ""

#: ui/debug_overlay.ja.md
msgid ""
"def update_label(self):\n"
"    # ラベルの text プロパティに表示する文字列を構築\n"
"    label_content = f\"{self.object}: {self.property_name} ({self.value})\"\n"
"    if self.mode == 'edit':\n"
"        label_content += \" (編集モード)\"\n"
"    elif self.mode == 'view':\n"
"        label_content += \" (閲覧モード)\""
msgstr ""

#: ui/debug_overlay.ja.md
msgid ""
"# 構築したコンテンツをラベルの text プロパティに設定\n"
"    self.widget.text = label_content\n"
"gdscript\n"
"func add_property(object, property, mode):\n"
"    var label = load(\"res://debug_overlay/"
"debug_label.tscn\").instantiate()\n"
"    $VBoxContainer.add_child(label)\n"
"    properties.append(Property.new(object, property, label, mode))"
msgstr ""

