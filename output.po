#: 3D/simple_airplane.ja.md
msgid ""
"func get_input(delta):\n"
"    # Throttle input\n"
"    if Input.is_action_pressed(\"throttle_up\"):\n"
"        target_speed = min(forward_speed + throttle_delta * delta, "
"max_flight_speed)\n"
"    if Input.is_action_pressed(\"throttle_down\"):\n"
"        var limit = 0 if grounded else min_flight_speed\n"
"        target_speed = max(forward_speed - throttle_delta * delta, limit)"
msgstr ""

#: 3D/simple_airplane.ja.md
#, fuzzy
msgid ""
"# Movement is always forward\n"
"    velocity = -transform.basis.z * forward_speed"
msgstr ""
"transform = xform\n"
"    velocity = -transform.basis.z * speed"

