msgid "<ul><li id=select-language-container class=footerLangSwitch><div class=\"padding select-container\"><i class=\"fas fa-language fa-fw\"></i> <span>&nbsp;</span><div class=select-style><label class=a11y-only for=select-language>Language</label> <select id=select-language onchange=\"location=baseUri+this.value\"><option lang=en id=en value=/godot_recipes/4.x/games/first_2d/first_2d_09/index.html selected></option></select>"
